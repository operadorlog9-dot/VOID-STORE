{
  "name": "void-store-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot Discord da VOID STORE com montagem automática, tickets, catálogo e controle de compradores.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "check": "node --check src/index.js && node --check src/deploy-commands.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.22.1",
    "dotenv": "^16.4.7"
  }
}
